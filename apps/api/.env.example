SERVER_ADDRESS=:8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_REQUEST_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_BODY_LIMIT=4194304

DATABASE_URL=postgres://ledgera:ledgera@localhost:5432/ledgera?sslmode=disable
DATABASE_HEALTH_TIMEOUT=2s
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

POSTGRES_DB=ledgera
POSTGRES_USER=ledgera
POSTGRES_PASSWORD=ledgera
API_PORT=8080
